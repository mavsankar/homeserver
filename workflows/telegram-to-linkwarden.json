    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst chatId = $('Parse Message').first().json.chatId;\nlet tagList = [];\nif (input.data && Array.isArray(input.data.tags)) {\n  tagList = input.data.tags.map(t => t.name).sort();\n} else if (Array.isArray(input)) {\n  tagList = input.map(t => t.name).sort();\n} else if (input.response && Array.isArray(input.response)) {\n  tagList = input.response.map(t => t.name).sort();\n}\nconst text = tagList.length > 0\n  ? '🏷️ Your tags:\\n\\n' + tagList.map(t => '• ' + t).join('\\n')\n  : '🏷️ No tags yet. Save a link and reply to it with tags.';\nreturn [{ json: { chatId, text } }];"
