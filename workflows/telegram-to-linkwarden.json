        "jsCode": "const response = $input.first().json;\nconst chatId = $('Parse Message').first().json.chatId;\nconst url = $('Parse Message').first().json.url;\nconst link = response.response || response;\nconst title = link.name || link.title || url;\nconst linkId = link.id;\nconst collection = link.collection || { id: link.collectionId, ownerId: link.createdById };\nconst tags = (link.tags || []).map(t => ({ id: t.id, name: t.name }));\nreturn [{ json: { url, title, chatId, linkId, collection, tags } }];"
