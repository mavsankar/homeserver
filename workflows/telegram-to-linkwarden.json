    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst text = msg.text || msg.caption || '';\nconst chatId = msg.chat.id;\n\n// Case 0: /tags command → list all tags\nif (text.trim().toLowerCase() === '/tags') {\n  return [{ json: { action: 'list_tags', chatId } }];\n}\n\n// Case 1: Reply to a saved message\nif (msg.reply_to_message && msg.reply_to_message.text) {\n  const replyText = msg.reply_to_message.text;\n  const savedMatch = replyText.match(/✅ Saved: (https?:\\/\\/[^\\s]+)/);\n  if (savedMatch) {\n    // /title command → rename the link\n    const titleMatch = text.match(/^\\/title\\s+(.+)$/i);\n    if (titleMatch) {\n      return [{ json: { action: 'rename_title', url: savedMatch[1], newTitle: titleMatch[1].trim(), chatId } }];\n    }\n    // Otherwise treat as tags\n    if (text.trim()) {\n      const tags = text.trim().split(/[,\\s]+/).filter(t => t.length > 0);\n      return [{ json: { action: 'categorize', url: savedMatch[1], tags, chatId } }];\n    }\n  }\n}\n\n// Case 2: Message contains a URL → save it\nconst entities = msg.entities || msg.caption_entities || [];\nfor (const entity of entities) {\n  if (entity.type === 'url') {\n    const url = text.substring(entity.offset, entity.offset + entity.length);\n    return [{ json: { action: 'save', url, chatId } }];\n  }\n  if (entity.type === 'text_link') {\n    return [{ json: { action: 'save', url: entity.url, chatId } }];\n  }\n}\nconst match = text.match(/https?:\\/\\/[^\\s<>\"']+/);\nif (match) {\n  return [{ json: { action: 'save', url: match[0].replace(/[),.!?;]+$/, ''), chatId } }];\n}\n\n// Case 3: No URL found\nreturn [{ json: { action: 'none', url: '', chatId } }];"
      },
