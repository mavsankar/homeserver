    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst parseMsg = $('Parse Message').first().json;\n\n// Handle various response structures from Linkwarden API\nlet links = [];\nif (Array.isArray(input)) {\n  links = input;\n} else if (input.response && Array.isArray(input.response)) {\n  links = input.response;\n} else if (Array.isArray(input.data)) {\n  links = input.data;\n} else {\n  const keys = Object.keys(input);\n  for (const key of keys) {\n    if (Array.isArray(input[key])) {\n      links = input[key];\n      break;\n    }\n  }\n}\n\nlet found = links.find(l => l.url === parseMsg.url);\nif (!found) {\n  found = links.find(l => l.url && l.url.includes(parseMsg.url));\n}\nif (!found && links.length > 0) {\n  found = links[0];\n}\n\nif (!found || !found.id) {\n  throw new Error('Could not find link in Linkwarden for URL: ' + parseMsg.url);\n}\n\nconst linkId = found.id;\nconst linkUrl = found.url;\nconst existingTags = (found.tags || []).map(t => ({ id: t.id, name: t.name }));\nconst collection = found.collection || { id: found.collectionId, ownerId: found.createdById };\n\n// New tags get id: 0 (tells Linkwarden to create them)\nconst newTags = parseMsg.tags.map(t => ({ id: 0, name: t }));\n// Merge and deduplicate by name (keep existing id if tag already exists)\nconst tagMap = new Map();\nfor (const t of existingTags) { tagMap.set(t.name.toLowerCase(), t); }\nfor (const t of newTags) { if (!tagMap.has(t.name.toLowerCase())) tagMap.set(t.name.toLowerCase(), t); }\nconst uniqueTags = [...tagMap.values()];\n\nreturn [{ json: { linkId, linkUrl, tags: uniqueTags, collection, chatId: parseMsg.chatId, url: parseMsg.url } }];"
      },
