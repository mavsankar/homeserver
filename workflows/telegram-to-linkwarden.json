    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst parseMsg = $('Parse Message').first().json;\n\nlet links = [];\nif (Array.isArray(input)) links = input;\nelse if (input.response && Array.isArray(input.response)) links = input.response;\nelse if (Array.isArray(input.data)) links = input.data;\nelse {\n  for (const key of Object.keys(input)) {\n    if (Array.isArray(input[key])) { links = input[key]; break; }\n  }\n}\n\nlet found = links.find(l => l.url === parseMsg.url);\nif (!found) found = links.find(l => l.url && l.url.includes(parseMsg.url));\nif (!found && links.length > 0) found = links[0];\n\nif (!found || !found.id) {\n  throw new Error('Could not find link for URL: ' + parseMsg.url);\n}\n\nconst collection = found.collection || { id: found.collectionId, ownerId: found.createdById };\nconst tags = (found.tags || []).map(t => ({ id: t.id, name: t.name }));\n\nreturn [{ json: { linkId: found.id, linkUrl: found.url, newTitle: parseMsg.newTitle, chatId: parseMsg.chatId, url: parseMsg.url, collection, tags } }];"
      },
