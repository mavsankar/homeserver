{
  "name": "Memos Reminder Cron",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a1b2c3d4-1111-4aaa-bbbb-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -800,
        400
      ]
    },
    {
      "parameters": {
        "url": "https://homememos.mavsankar.com/api/v1/memos?pageSize=50&filter=content.contains(\"%23pending\")",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4aaa-bbbb-000000000002",
      "name": "Fetch Pending Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -576,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "oKlO3q3UPuoqpAPx",
          "name": "Memos Access Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet memos = input.memos || [];\nif (!Array.isArray(memos)) memos = [];\n\nconst now = new Date();\nconst dueReminders = [];\n\nfor (const memo of memos) {\n  const content = memo.content || '';\n  \n  // Only process memos with both #reminder and #pending\n  if (!content.includes('#reminder') || !content.includes('#pending')) continue;\n  \n  // Extract due date\n  const dueMatch = content.match(/📅 Due: ([^\\n]+)/);\n  if (!dueMatch) continue;\n  \n  const dueDate = new Date(dueMatch[1].trim());\n  if (isNaN(dueDate.getTime())) continue;\n  \n  // Check if due\n  if (dueDate > now) continue;\n  \n  // Extract chat ID\n  const chatMatch = content.match(/💬 Chat: (\\d+)/);\n  if (!chatMatch) continue;\n  \n  // Extract reminder text\n  const textMatch = content.match(/⏰ REMINDER: ([^\\n]+)/);\n  if (!textMatch) continue;\n  \n  dueReminders.push({\n    memoName: memo.name,\n    chatId: chatMatch[1],\n    reminderText: textMatch[1],\n    content: content\n  });\n}\n\nif (dueReminders.length === 0) {\n  return [];\n}\n\nreturn dueReminders.map(r => ({ json: r }));"
      },
      "id": "a1b2c3d4-1111-4aaa-bbbb-000000000003",
      "name": "Filter Due Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -352,
        400
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ '🔔 REMINDER:\\n\\n' + $json.reminderText }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1b2c3d4-1111-4aaa-bbbb-000000000004",
      "name": "Send Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        -128,
        400
      ],
      "credentials": {
        "telegramApi": {
          "id": "usfpmxbYsxB8MkCR",
          "name": "Memos Bot"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://homememos.mavsankar.com/api/v1/' + $('Filter Due Reminders').item.json.memoName }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $('Filter Due Reminders').item.json.content.replace('#pending', '#sent') }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4aaa-bbbb-000000000005",
      "name": "Mark Reminder Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        96,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "oKlO3q3UPuoqpAPx",
          "name": "Memos Access Token"
        }
      }
    }
  ],
