    {
      "parameters": {
        "jsCode": "const parseMsg = $('Parse Message').first().json;\nconst tag = parseMsg.tag;\nconst content = parseMsg.content;\n\nconst emojis = {\n  thought: '💭',\n  todo: '✅',\n  idea: '💡',\n  code: '👨‍💻',\n  project: '🚀',\n  reminder: '⏰'\n};\n\nconst emoji = emojis[tag] || '💭';\nconst preview = content.length > 100 ? content.substring(0, 100) + '...' : content;\n\nreturn [{ json: { chatId: parseMsg.chatId, text: `${emoji} Saved [#${tag}]:\\n${preview}` } }];"
      },
