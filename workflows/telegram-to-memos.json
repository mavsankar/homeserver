    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst chatId = $('Parse Message').first().json.chatId;\nlet memos = input.memos || [];\nif (!Array.isArray(memos)) memos = [];\n\n// Extract all #tags from memo content\nconst tagSet = new Set();\nfor (const m of memos) {\n  const matches = (m.content || '').match(/#[\\w-]+/g);\n  if (matches) matches.forEach(t => tagSet.add(t));\n}\n\nconst tags = [...tagSet].sort();\nif (tags.length === 0) {\n  return [{ json: { chatId, text: '🏷️ No tags yet.' } }];\n}\n\nreturn [{ json: { chatId, text: '🏷️ Your tags:\\n\\n' + tags.map(t => '• ' + t).join('\\n') } }];"
      },
