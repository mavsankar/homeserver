    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst chatId = $('Parse Message').first().json.chatId;\nlet memos = input.memos || [];\nif (!Array.isArray(memos)) memos = [];\n\nif (memos.length === 0) {\n  return [{ json: { chatId, text: '🔍 No memos found matching your query.' } }];\n}\n\nconst lines = memos.slice(0, 5).map((m, i) => {\n  const date = m.createTime ? m.createTime.substring(0, 10) : '';\n  const snippet = (m.content || '').replace(/\\n/g, ' ').substring(0, 80);\n  return `${i + 1}. [${date}] ${snippet}`;\n});\n\nreturn [{ json: { chatId, text: '🔍 Found ' + memos.length + ' memo(s):\\n\\n' + lines.join('\\n\\n') } }];"
