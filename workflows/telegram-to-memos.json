        "jsCode": "const input = $input.first().json;\nconst chatId = $('Parse Message').first().json.chatId;\nlet memos = input.memos || [];\nif (!Array.isArray(memos)) memos = [];\n\nif (memos.length === 0) {\n  return [{ json: { chatId, text: '🎲 No memos to resurface yet!' } }];\n}\n\nconst random = memos[Math.floor(Math.random() * memos.length)];\nconst date = random.createTime ? random.createTime.substring(0, 10) : '';\nconst content = (random.content || '').substring(0, 300);\n\nreturn [{ json: { chatId, text: `🎲 From ${date}:\\n\\n${content}` } }];"
