    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst text = msg.text || msg.caption || '';\nconst chatId = msg.chat.id;\n\n// Allowed chat ID check (set your own)\n// const ALLOWED_CHAT_ID = 123456789;\n// if (chatId !== ALLOWED_CHAT_ID) {\n//   return [{ json: { action: 'unauthorized', chatId } }];\n// }\n\n// Use Telegram entities to reliably detect bot commands\nconst entities = msg.entities || msg.caption_entities || [];\nconst botCmd = entities.find(e => e.type === 'bot_command' && e.offset === 0);\n\nlet command = '';\nlet args = '';\nif (botCmd) {\n  command = text.substring(0, botCmd.length).toLowerCase().replace(/@.*$/, '');\n  args = text.substring(botCmd.length).trim();\n}\n\n// Commands without arguments\nif (command === '/start' || command === '/help') {\n  return [{ json: { action: 'help', chatId } }];\n}\nif (command === '/recent') {\n  return [{ json: { action: 'recent', chatId } }];\n}\nif (command === '/random') {\n  return [{ json: { action: 'random', chatId } }];\n}\nif (command === '/tags') {\n  return [{ json: { action: 'tags', chatId } }];\n}\n\n// Commands with arguments\nif (command === '/search' && args) {\n  return [{ json: { action: 'search', query: args, chatId } }];\n}\nif (command === '/remind' && args) {\n  const match = args.match(/^(\\d+)([mhd])\\s+(.+)$/i);\n  if (match) {\n    const amount = parseInt(match[1]);\n    const unit = match[2].toLowerCase();\n    let delayMs = 0;\n    if (unit === 'm') delayMs = amount * 60 * 1000;\n    else if (unit === 'h') delayMs = amount * 3600 * 1000;\n    else if (unit === 'd') delayMs = amount * 86400 * 1000;\n    const targetTime = new Date(Date.now() + delayMs).toISOString();\n    return [{ json: { action: 'remind', reminderText: match[3], targetTime, chatId } }];\n  }\n  return [{ json: { action: 'save', content: args, tag: 'reminder', chatId } }];\n}\nif (command === '/todo' && args) {\n  return [{ json: { action: 'save', content: '- [ ] ' + args, tag: 'todo', chatId } }];\n}\nif (command === '/idea' && args) {\n  return [{ json: { action: 'save', content: args, tag: 'idea', chatId } }];\n}\nif (command === '/code' && args) {\n  return [{ json: { action: 'save', content: '```\\n' + args + '\\n```', tag: 'code', chatId } }];\n}\nif (command === '/project' && args) {\n  return [{ json: { action: 'save', content: args, tag: 'project', chatId } }];\n}\n\n// Default: plain thought (no command prefix)\nconst trimmed = text.trim();\nif (trimmed.length > 0) {\n  return [{ json: { action: 'save', content: trimmed, tag: 'thought', chatId } }];\n}\n\nreturn [{ json: { action: 'help', chatId } }];"
      },
