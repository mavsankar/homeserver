        -1664,
        800
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst batteryLevel = body.battery_level ?? null;\nconst isCharging = body.is_charging ?? false;\n\n// Quiet hours check (don't notify between 11 PM and 7 AM)\nconst now = new Date();\nconst hour = now.getHours();\nconst isQuietHours = hour >= 23 || hour < 7;\n\nif (isQuietHours) {\n  return [{ json: { action: 'skip', reason: 'quiet_hours' } }];\n}\n\n// Charging and battery > 80% — remind to wear\nif (isCharging && batteryLevel !== null && batteryLevel > 80) {\n  return [{ json: { action: 'wear', batteryLevel } }];\n}\n\n// Not charging and battery is low — remind to charge\nif (!isCharging && batteryLevel !== null && batteryLevel <= 20) {\n  return [{ json: { action: 'charge', batteryLevel } }];\n}\n\n// Everything else — no action\nreturn [{ json: { action: 'skip', reason: 'no_action_needed' } }];\n"
      },
      "id": "c31c6f99-d4ce-4ce1-8419-0b126dff72cd",
      "name": "Process Watch Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1664,
        608
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.action }}",
        "rules": {
