      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst services = [];\nfor (const item of items) {\n  const group = item.json;\n  const catName = group.name || 'Other';\n  const svcList = group.services || [];\n  for (const svc of svcList) {\n    services.push({\n      category: catName,\n      name: svc.name || '',\n      description: svc.description || '',\n      details: svc.details || '',\n      docs: svc.docs || null,\n      icon: svc.icon || null\n    });\n  }\n}\n\nreturn [{ json: { services, lastUpdated: new Date().toISOString() } }];"
      },
