# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-db-password

# ── GlitchTip ───────────────────────────────────────────────────────────────
# Generate a long random value, e.g. PowerShell:
#   [Convert]::ToBase64String((1..50 | ForEach-Object { Get-Random -Max 256 }))
GLITCHTIP_SECRET_KEY=change-me-long-random-secret

# OPTIONAL — only used as the "from" address on outgoing emails. With the
# console mailer below, nothing is actually sent, so you can leave this blank
# for now (defaults to webmaster@localhost). Set it when you enable SMTP alerts.
GLITCHTIP_FROM_EMAIL=

# Alerts are deferred for now, so log emails to the console.
# Later, switch to SMTP, e.g.:
#   smtp://user:pass@smtp.zoho.com:587
GLITCHTIP_EMAIL_URL=consolemail://
