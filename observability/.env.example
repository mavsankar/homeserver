# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
# Change this before first start:
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# ── Telemetry gateway ───────────────────────────────────────────────────────
# Shared secret the BACKEND uses to post audit events to /server.
# Generate one, e.g. PowerShell:  [guid]::NewGuid().ToString("N")
INGEST_TOKEN=change-me-long-random-token

# Comma-separated browser origins allowed to POST to /web (no spaces).
INGEST_ALLOWED_ORIGINS=https://jisst.com,https://www.jisst.com,https://fsrti.jisst.com
